# ============================================================
# Relayer configuration
# ============================================================
# Copy to .env and fill in HYP_DEFAULTSIGNER_KEY.
# NEVER commit .env to git. See .gitignore.

# ---- Required: relayer signing key ----
# This is the private key whose address pays gas on every destination chain.
# It must be funded with:
#   - ETH on Base
#   - L1 on GenesisL1
HYP_DEFAULTSIGNER_KEY=0x

# ---- Optional tweaks ----
# Increase for more verbose logs during setup
HYP_LOG_LEVEL=info

# ---- Advanced: stricter gas payment enforcement ----
# Default (in docker-compose.yml) is 'none' because this route has no IGP.
# If you run a private relayer and an IGP is later deployed, override here:
#
# HYP_GASPAYMENTENFORCEMENT=[{"type":"minimum","payment":"1"}]
