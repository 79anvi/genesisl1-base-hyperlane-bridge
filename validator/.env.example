# ============================================================
# Validator configuration — one file for one or both chains
# ============================================================
# Copy to .env and fill in the blanks.
# NEVER commit .env to git. See .gitignore.

# ---- Required: validator signing key ----
# The private key your validator uses to sign checkpoints.
# Generate a fresh one with scripts/generate-validator-key.sh
# Use a UNIQUE key per validator (one for GenesisL1, another for Base).
HYP_VALIDATOR_KEY=0x

# Signer keys used to pay gas for the announce() transaction on each chain.
# Usually the same as HYP_VALIDATOR_KEY, but you can use a separate funded
# key if you prefer to keep validator signing and fee-paying separate.
HYP_CHAINS_GENESISL1_SIGNER_KEY=0x
HYP_CHAINS_BASE_SIGNER_KEY=0x

# ---- Optional: S3 checkpoint storage ----
# If you want to publish checkpoints to S3 instead of local filesystem,
# uncomment these and change HYP_CHECKPOINTSYNCER_TYPE=s3 in the
# docker-compose.yml environment.
#
# HYP_CHECKPOINTSYNCER_TYPE=s3
# HYP_CHECKPOINTSYNCER_BUCKET=my-validator-bucket
# HYP_CHECKPOINTSYNCER_REGION=us-east-1
# HYP_CHECKPOINTSYNCER_FOLDER=hyperlane-validator
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Log level ----
# Set to debug for verbose output during setup.
HYP_LOG_LEVEL=info
